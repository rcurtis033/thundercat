# Copy to .env (gitignored) and fill in the keys for the agents you want.

# GPT agent: create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Grok agent: create a key at https://console.x.ai
XAI_API_KEY=

# Optional overrides — the defaults are shown.
# THUNDERCAT_GPT_MODEL=gpt-6-astra
# THUNDERCAT_GPT_REASONING_EFFORT=max
# THUNDERCAT_GPT_REASONING_MODE=standard
# THUNDERCAT_GROK_MODEL=grok-4.7
# THUNDERCAT_GROK_REASONING_EFFORT=xhigh
# THUNDERCAT_WORKSPACE=.
# THUNDERCAT_MAX_TURNS=25
# THUNDERCAT_TRACING=0
# OPENAI_BASE_URL=https://api.openai.com/v1
# XAI_BASE_URL=https://api.x.ai/v1
